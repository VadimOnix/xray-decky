---
import Base from '../../layouts/Base.astro';
import Guide from '../../components/Guide.astro';
import { ru } from '../../i18n/ru';

// The guide has its own <title>/description (t.guide.seo) — everything else
// (nav, footer, stylesheet) reuses the shared RU dictionary via Base.astro,
// same pattern as the EN guide page.
const t = { ...ru, seo: ru.guide.seo };
---
<Base t={t} locale="ru" path="vpn-on-steam-deck.html">
  <Guide t={ru} locale="ru" />
</Base>
