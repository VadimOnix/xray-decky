---
import Base from '../../layouts/Base.astro';
import Guide from '../../components/Guide.astro';
import { fa } from '../../i18n/fa';

// The guide has its own <title>/description (t.guide.seo) — everything else
// (nav, footer, stylesheet) reuses the shared FA dictionary via Base.astro,
// same pattern as the EN guide page.
const t = { ...fa, seo: fa.guide.seo };
---
<Base t={t} locale="fa" path="vpn-on-steam-deck.html">
  <Guide t={fa} locale="fa" />
</Base>
