---
import Base from '../../layouts/Base.astro';
import Guide from '../../components/Guide.astro';
import { es } from '../../i18n/es';

// The guide has its own <title>/description (t.guide.seo) — everything else
// (nav, footer, stylesheet) reuses the shared ES dictionary via Base.astro,
// same pattern as the EN guide page.
const t = { ...es, seo: es.guide.seo };
---
<Base t={t} locale="es" path="vpn-on-steam-deck.html">
  <Guide t={es} locale="es" />
</Base>
