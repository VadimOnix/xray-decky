---
import type { Dict } from '../i18n/types';
import { withBase } from '../lib/urls';
import Donate from './Donate.astro';

interface Props {
  t: Dict;
  /** Not read yet — forward-compat for Task 7, which will need it for locale-specific demo/markup tweaks. */
  locale: string;
}

const { t } = Astro.props;

// Paired with t.features by index (both are always 8 long, same order as
// docs/index.html) rather than hand-duplicating a <li> per feature — a
// locale dict with a different length or order can't silently desync the
// icon from its copy.
const FEATURE_ICONS: string[] = [
  '<svg viewBox="0 0 24 24"><path d="M12 3v10m0 0 4-4m-4 4-4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M4 6h16M4 12h16M4 18h10"/><circle cx="19" cy="18" r="2"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M13 3 4 14h6l-1 7 9-11h-6l1-7z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M3 17l4-6 4 3 4-8 6 11"/><path d="M3 21h18"/></svg>',
  '<svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M7 9h4m-4 3h7"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4z"/><path d="M14 14h3v3h-3zM17 17h3v3h-3z"/></svg>',
  '<svg viewBox="0 0 24 24"><path d="M12 21a9 9 0 1 0-9-9"/><path d="M3 12h9m0 0V3"/></svg>',
];
---

<!-- Hero -->
<header class="hero" id="top">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="hero-inner">
    <div class="hero-copy">
      <p class="hero-badge"><span class="badge-stable">{t.hero.badgeStable}</span> {t.hero.badgeContext}</p>
      <h1 id="hero-title" set:html={t.hero.titleHtml} />
      <p class="hero-purpose">
        {t.hero.purpose}
      </p>
      <div class="hero-actions">
        <a href="#install" class="btn btn-primary">{t.hero.ctaInstall}</a>
        <a href="https://github.com/VadimOnix/xray-decky" class="btn btn-secondary" target="_blank" rel="noopener"
          >{t.hero.ctaGithub}</a
        >
      </div>
      <ul class="hero-stats" aria-label={t.hero.statsAriaLabel}>
        {t.hero.stats.map((stat) => (
          <li>
            {stat.countup !== undefined ? (
              <b data-countup={stat.countup}>0</b>
            ) : (
              <b>{stat.value}</b>
            )}
            <span>{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Animated demo: Steam Deck (QAM) + phone (admin panel) -->
    <div class="hero-demo" id="demo" data-state="idle" aria-label={t.hero.demoAriaLabel}>
      <div class="demo-stage">
      <!-- Steam Deck -->
      <div class="deck" aria-hidden="true">
        <div class="deck-side deck-side-l">
          <span class="deck-mini-btn"></span>
          <div class="deck-stick"></div>
          <div class="deck-dpad"></div>
          <div class="deck-trackpad"></div>
          <span class="deck-sys-btn deck-steam-btn"></span>
        </div>
        <div class="deck-screen">
          <div class="deck-game">
            <div class="deck-game-sky"></div>
            <div class="deck-game-hills"></div>
            <div class="deck-game-hud"><span></span><span></span></div>
          </div>
          <div class="qam">
            <div class="qam-head">
              <span class="qam-logo"></span>
              <span class="qam-title">XRAY DECKY</span>
            </div>
            <div class="qam-status">
              <span class="qam-dot"></span>
              <span class="qam-status-text" data-demo="deck-status">{t.hero.demo.deckStatus}</span>
            </div>
            <div class="qam-row">
              <span>{t.hero.demo.enableConnection}</span>
              <span class="qam-switch"><span class="qam-knob"></span></span>
            </div>
            <div class="qam-speed">
              <span class="spd-down">▼ <b data-demo="deck-down">0 KB/s</b></span>
              <span class="spd-up">▲ <b data-demo="deck-up">0 KB/s</b></span>
            </div>
            <div class="qam-server">
              <span class="qam-proto">VLESS</span>
              <span class="qam-server-name">DE · Frankfurt</span>
              <span class="qam-lat" data-demo="deck-lat">— ms</span>
            </div>
            <div class="qam-opts">
              <span class="qam-opt on">TUN</span>
              <span class="qam-opt">Kill switch</span>
            </div>
          </div>
        </div>
        <div class="deck-side deck-side-r">
          <span class="deck-mini-btn"></span>
          <div class="deck-stick"></div>
          <div class="deck-btns"><i></i><i></i><i></i><i></i></div>
          <div class="deck-trackpad"></div>
          <span class="deck-sys-btn deck-qam-btn">···</span>
        </div>
      </div>

      <!-- Phone with the admin panel -->
      <div class="phone" aria-hidden="true">
        <div class="phone-notch"></div>
        <div class="phone-screen">
          <div class="ph-topbar">
            <span class="ph-brand">XRAY <b>DECKY</b></span>
            <span class="ph-pill" data-demo="phone-pill">{t.hero.demo.phonePill}</span>
          </div>
          <div class="ph-hero">
            <span class="ph-orb"></span>
            <span class="ph-hero-text">
              <b data-demo="phone-status">{t.hero.demo.phoneStatus}</b>
              <i data-demo="phone-sub">{t.hero.demo.phoneSub}</i>
            </span>
          </div>
          <div class="ph-chips">
            <span class="chip chip-down">▼ <b data-demo="phone-down">0 KB/s</b></span>
            <span class="chip chip-up">▲ <b data-demo="phone-up">0 KB/s</b></span>
          </div>
          <svg class="ph-graph" viewBox="0 0 100 26" preserveAspectRatio="none">
            <polyline class="ph-line ph-line-down" data-demo="line-down" points=""></polyline>
            <polyline class="ph-line ph-line-up" data-demo="line-up" points=""></polyline>
          </svg>
          <div class="ph-servers">
            <div class="ph-server is-active">
              <span class="ph-proto">VLESS</span><span class="ph-name">DE · Frankfurt</span><span class="ph-lat" data-demo="lat-1">—</span>
            </div>
            <div class="ph-server">
              <span class="ph-proto">TROJAN</span><span class="ph-name">NL · Amsterdam</span><span class="ph-lat" data-demo="lat-2">—</span>
            </div>
            <div class="ph-server">
              <span class="ph-proto">SS</span><span class="ph-name">FI · Helsinki</span><span class="ph-lat" data-demo="lat-3">—</span>
            </div>
          </div>
        </div>
      </div>
      </div>

      <p class="demo-caption">{t.hero.demoCaption}</p>
    </div>
  </div>
</header>

<main>
  <!-- Protocol strip -->
  <section class="protocols reveal" aria-label={t.protocols.ariaLabel}>
    <div class="proto-strip">
      {t.protocols.chips.map((chip) => <span class="proto-chip">{chip}</span>)}
      <span class="proto-note">{t.protocols.note}</span>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features" aria-labelledby="features-title">
    <h2 id="features-title" class="reveal">{t.featuresTitle}</h2>
    <ul class="feature-grid">
      {t.features.map((f, i) => (
        <li class="feature-card reveal">
          <span class="f-icon" aria-hidden="true" set:html={FEATURE_ICONS[i]} />
          <h3>{f.title}</h3>
          <p set:html={f.html} />
        </li>
      ))}
    </ul>
  </section>

  <!-- Admin panel spotlight -->
  <section class="panel-spot" id="panel" aria-labelledby="panel-title">
    <div class="panel-spot-inner reveal">
      <div class="panel-copy">
        <h2 id="panel-title" set:html={t.panel.titleHtml} />
        <p set:html={t.panel.introHtml} />
        <ul class="panel-list">
          {t.panel.list.map((item) => <li>{item}</li>)}
        </ul>
        <p class="panel-security" set:html={t.panel.securityHtml} />
      </div>
    </div>
  </section>

  <!-- Installation -->
  <section class="install" id="install" aria-labelledby="install-title">
    <h2 id="install-title" class="reveal">{t.install.title}</h2>

    <div class="install-prereq reveal">
      <h3>{t.install.prereqTitle}</h3>
      <ul>
        {t.install.prereqHtml.map((item) => <li set:html={item} />)}
      </ul>
    </div>

    <div class="install-methods">
      {t.install.methods.map((method, i) => (
        <div class={`install-method${i === 0 ? ' install-method--primary' : ''} reveal`}>
          <h3>{method.title}</h3>
          <ol>
            {method.stepsHtml.map((step) => <li set:html={step} />)}
          </ol>
        </div>
      ))}
    </div>

    <p class="install-note reveal" set:html={t.install.noteHtml} />

    <div class="tun-setup reveal">
      <h3>{t.install.tunTitle}</h3>
      <p set:html={t.install.tunHtml} />
    </div>
  </section>

  <!-- Usage -->
  <section class="usage" id="usage" aria-labelledby="usage-title">
    <h2 id="usage-title" class="reveal">{t.usageTitle}</h2>
    <div class="usage-steps">
      {t.usage.map((step) => (
        <div class="usage-step reveal">
          <span class="step-number">{step.number}</span>
          <div>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Troubleshooting -->
  <section class="troubleshooting" id="faq" aria-labelledby="troubleshooting-title">
    <h2 id="troubleshooting-title" class="reveal">{t.faqTitle}</h2>
    <div class="faq-list reveal">
      {t.faq.map((item) => (
        <details class="faq-item">
          <summary>{item.q}</summary>
          <Fragment set:html={item.html} />
        </details>
      ))}
    </div>
  </section>

  <Donate t={t} />
</main>

<script is:inline src={withBase('scripts/demo.js')} defer></script>
<script is:inline src={withBase('scripts/donate.js')} defer></script>
