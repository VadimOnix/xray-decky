---
import type { Dict } from '../i18n/types';

interface Props {
  t: Dict;
  /**
   * Canonical URL for the SoftwareApplication entity. Per spec this is
   * always the EN landing page's canonical URL — even when this component
   * is rendered on a future localized landing page — so every locale
   * shares one JSON-LD software identity instead of fragmenting it per
   * locale.
   */
  canonical: string;
}

const { t, canonical } = Astro.props;

/**
 * Strip markup from FAQ answer HTML so the JSON-LD payload carries plain
 * text. Answers are authored as `<ul><li>...</li></ul>` lists (see
 * en.ts's `faq` entries) with no trailing punctuation per item, so block
 * boundaries are turned into ". " first — otherwise adjacent list items
 * would run together into one unpunctuated sentence.
 */
const stripHtml = (html: string): string =>
  html
    .replace(/<\/(li|p)>|<br\s*\/?>/gi, '. ')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .replace(/\s+\./g, '.')
    .replace(/\.{2,}/g, '.')
    .trim();

/**
 * JSON.stringify does not escape "</script>", so a dict string containing it
 * would terminate the inline script block early. Escape every "<" — valid
 * JSON, and browsers parse the < form identically.
 */
const toJsonLd = (value: unknown): string =>
  JSON.stringify(value).replace(/</g, '\\u003c');

const softwareApplication = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Xray Decky',
  operatingSystem: 'SteamOS (Linux)',
  applicationCategory: 'UtilitiesApplication',
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
  },
  url: canonical,
  softwareVersion: '2.2.0',
  license: 'MIT',
  sameAs: 'https://github.com/VadimOnix/xray-decky',
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: stripHtml(item.html),
    },
  })),
};
---

<script type="application/ld+json" set:html={toJsonLd(softwareApplication)} is:inline />
<script type="application/ld+json" set:html={toJsonLd(faqPage)} is:inline />
