{
  "name": "xray-decky",
  "version": "2.3.1",
  "description": "VPN & proxy client for Steam Deck — Decky Loader plugin for VLESS (REALITY), VMess, Trojan, Shadowsocks, Hysteria2 and TUIC with TUN mode for Gaming Mode",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "pnpm run lint:eslint && pnpm run lint:prettier",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check 'src/**/*.{ts,tsx,js,json}' 'tests/frontend/**/*.ts' '*.{json,mjs,ts}'",
    "lint:ts": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "lint:fix": "eslint . --fix && pnpm run format",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,json}' 'tests/frontend/**/*.ts' '*.{json,mjs,ts}'",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "./deploy.sh",
    "package": "./package-and-deploy.sh",
    "package:local": "./scripts/package-local.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VadimOnix/xray-decky.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "vless",
    "proxy",
    "xray",
    "vpn",
    "vpn-client",
    "steam-deck",
    "steamos",
    "sing-box"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/VadimOnix/xray-decky/issues"
  },
  "homepage": "https://github.com/VadimOnix/xray-decky#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@eslint/js": "^9.39.3",
    "@rollup/rollup-linux-x64-musl": "^4.59.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/webpack": "^5.28.5",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "rollup": "^4.59.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "decky-frontend-lib": "^3.25.0",
    "qrcode.react": "^4.1.0",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
